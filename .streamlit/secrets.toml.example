# Copy this file to .streamlit/secrets.toml and set your own password.
# NEVER commit the real secrets.toml to GitHub — it's already in .gitignore.
#
# On Streamlit Community Cloud: don't upload secrets.toml at all.
# Instead go to your app -> Settings -> Secrets, and paste:
#   app_password = "your-password-here"

app_password = "change-this-password"
